# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=open-assistant

#:docker-compose.ext.yml
COMPOSE_EXTENDS=

COMPOSE_FILE=docker-compose.yml:docker-compose.base.yml:docker-compose.ferron.yml:docker-compose.db.yml:docker-compose.redis.yml:docker-compose.minio.yml${COMPOSE_EXTENDS:-}

# Worker
OPENAI_API_BASE=https://openai.com/api/v1
OPENAI_API_KEY=your_openai_api_key

LLM_MAX_STEP=25
TOOL_WORKER_NUM=10
TOOL_WORKER_EXECUTION_TIMEOUT=180

# Api
ASSISTANT_API_APP_NAME=open-assistant-api
ASSISTANT_API_APP_API_PREFIX=/api
MIGRATION_ENABLED=true # celary

# Api and Worker
ASSISTANT_WORKERS=20
APP_DEBUG=false
APP_ENV=prod
APP_AUTH_ENABLE=false
APP_AUTH_ADMIN_TOKEN=admin
APP_AES_ENCRYPTION_KEY=7700b2f9c8dd982dfaddf8b47a92f1d900507ee8ac335f96a64e9ca0f018b195
FILE_SERVICE_MODULE=app.services.file.impl.oss_file.OSSFileService
# FILE_SERVICE_MODULE: app.services.file.impl.r2r_file.R2RFileService
LOG_LEVEL=INFO

# Api and Worker (database)
DB_HOST=open-assistant-db
DB_PORT=3306
DB_DATABASE=open_assistant
DB_USER=open_assistant
DB_PASSWORD=J8Z3EFRCSPB8KxdDPiBUpKFWu9sQAGxL
